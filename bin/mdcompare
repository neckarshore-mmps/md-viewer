#!/usr/bin/env bash
# mdcompare — the Finder quick action "Compare": convert a PDF with md-converter (if its
# results are missing) and open the comparison view pre-filled with the PDF and its
# results. All the work is `md-converter compare`; this script only finds uv, which a
# Finder service does not have on its PATH, and turns failures into visible messages.
#
# Usage: mdcompare <file.pdf>
# Results land in $MD_CONVERTER_OUT (default ~/md-converter/<doc>/); the PDF itself is
# never written. MDCOMPARE_NO_OPEN=1 prints the page path instead of opening a browser.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONVERTER="$ROOT/converter"

# Titles and messages carry the PDF's filename and converter output, so they are never
# pasted into AppleScript source: they travel as arguments and are read via `on run argv`.
# A filename like `x" & do shell script "..." & ".pdf` stays plain text.
notify() {   # title, message — a macOS notification when run from Finder, stderr otherwise
  if [ -n "${MDCOMPARE_QUIET:-}" ] || ! command -v osascript >/dev/null 2>&1; then
    echo "mdcompare: $1: $2" >&2
    return
  fi
  osascript -e 'on run argv' \
    -e 'display notification (item 2 of argv) with title "md-viewer" subtitle (item 1 of argv)' \
    -e 'end run' -- "$1" "$2" >/dev/null 2>&1 || true
}

alert() {    # title, message — a dialog for failures, so they cannot pass unnoticed
  if [ -n "${MDCOMPARE_QUIET:-}" ] || ! command -v osascript >/dev/null 2>&1; then
    echo "mdcompare: $1: $2" >&2
    return
  fi
  osascript -e 'on run argv' \
    -e 'display alert (item 1 of argv) message (item 2 of argv)' \
    -e 'end run' -- "$1" "$2" >/dev/null 2>&1 || true
}

if [ $# -lt 1 ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "Usage: mdcompare <file.pdf>" >&2
  exit 2
fi
pdf="$1"

# A Finder service starts with PATH=/usr/bin:/bin:/usr/sbin:/sbin; uv lives elsewhere.
# Appended, not prepended: an existing PATH (a terminal, a test) keeps its precedence.
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.cargo/bin"
if ! command -v uv >/dev/null 2>&1; then
  alert "Compare: uv not found" "Install uv (https://docs.astral.sh/uv/), then run: cd $CONVERTER && uv sync --extra docling"
  exit 2
fi

notify "Compare" "Converting $(basename "$pdf") ..."
args=(compare "$pdf")
[ "${MDCOMPARE_NO_OPEN:-}" = "1" ] && args+=(--no-open)

log="$(mktemp "${TMPDIR:-/tmp}/mdcompare.XXXXXX")"
page="$(uv run --quiet --project "$CONVERTER" md-converter "${args[@]}" 2>"$log")"
rc=$?
reason="$(grep -E '^(FAIL|FAILED)' "$log" | tail -3)"
[ -n "$reason" ] || reason="$(tail -3 "$log")"

if [ -z "$page" ]; then
  alert "Compare failed: $(basename "$pdf")" "$reason"
  rm -f "$log"
  exit "${rc:-1}"
fi
if [ "$rc" -ne 0 ]; then
  notify "Compare: a converter failed" "$reason"
fi
[ "${MDCOMPARE_NO_OPEN:-}" = "1" ] && echo "$page"
rm -f "$log"
exit "$rc"
